# Sao chép thành .env rồi điền giá trị:  cp .env.example .env
# .env đã nằm trong .gitignore — KHÔNG commit. Khi lộ khóa: thu hồi ngay trên trang nhà cung cấp.
# Chỉ cần điền khóa của dịch vụ bạn thực sự dùng.

# LLM API (Nhóm 5, 6, 7) — chọn ít nhất một nhà cung cấp
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hugging Face (tải model có giới hạn truy cập)
HF_TOKEN=

# Tracing LLM (Langfuse — tự host hoặc cloud)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Kaggle API để tải dữ liệu luyện tập (hoặc đặt file ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Giới hạn chi tiêu tự đặt cho script luyện tập (USD/ngày) — script nên đọc và dừng khi vượt
LLM_DAILY_BUDGET_USD=2
