{
  "$defs": {
    "AudioConfig": {
      "properties": {
        "rate": {
          "default": 16000,
          "title": "Rate",
          "type": "integer"
        },
        "format": {
          "default": "pcm_s16le",
          "title": "Format",
          "type": "string"
        }
      },
      "title": "AudioConfig",
      "type": "object"
    },
    "ClientHealth": {
      "properties": {
        "type": {
          "const": "client.health",
          "default": "client.health",
          "title": "Type",
          "type": "string"
        },
        "audio_context_state": {
          "default": "running",
          "title": "Audio Context State",
          "type": "string"
        },
        "track_muted": {
          "default": false,
          "title": "Track Muted",
          "type": "boolean"
        },
        "track_ended": {
          "default": false,
          "title": "Track Ended",
          "type": "boolean"
        },
        "rms_dbfs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rms Dbfs"
        },
        "chunks_sent": {
          "default": 0,
          "title": "Chunks Sent",
          "type": "integer"
        },
        "document_visible": {
          "default": true,
          "title": "Document Visible",
          "type": "boolean"
        }
      },
      "title": "ClientHealth",
      "type": "object"
    },
    "Ping": {
      "properties": {
        "type": {
          "const": "ping",
          "default": "ping",
          "title": "Type",
          "type": "string"
        },
        "t": {
          "title": "T",
          "type": "integer"
        }
      },
      "required": [
        "t"
      ],
      "title": "Ping",
      "type": "object"
    },
    "SessionStart": {
      "properties": {
        "type": {
          "const": "session.start",
          "default": "session.start",
          "title": "Type",
          "type": "string"
        },
        "protocol": {
          "default": 1,
          "title": "Protocol",
          "type": "integer"
        },
        "audio": {
          "$ref": "#/$defs/AudioConfig"
        },
        "sides": {
          "additionalProperties": {
            "$ref": "#/$defs/SideConfig"
          },
          "propertyNames": {
            "enum": [
              "A",
              "B"
            ]
          },
          "title": "Sides",
          "type": "object"
        },
        "targets": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "ja",
                  "en",
                  "vi"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targets"
        },
        "client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Client Id"
        }
      },
      "title": "SessionStart",
      "type": "object"
    },
    "SideConfig": {
      "properties": {
        "lang": {
          "default": "auto",
          "title": "Lang",
          "type": "string"
        }
      },
      "title": "SideConfig",
      "type": "object"
    },
    "SidesUpdate": {
      "properties": {
        "type": {
          "const": "sides.update",
          "default": "sides.update",
          "title": "Type",
          "type": "string"
        },
        "sides": {
          "additionalProperties": {
            "$ref": "#/$defs/SideConfig"
          },
          "propertyNames": {
            "enum": [
              "A",
              "B"
            ]
          },
          "title": "Sides",
          "type": "object"
        },
        "targets": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "ja",
                  "en",
                  "vi"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targets"
        }
      },
      "required": [
        "sides"
      ],
      "title": "SidesUpdate",
      "type": "object"
    },
    "TurnStart": {
      "properties": {
        "type": {
          "const": "turn.start",
          "default": "turn.start",
          "title": "Type",
          "type": "string"
        },
        "side": {
          "enum": [
            "A",
            "B"
          ],
          "title": "Side",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "mic",
                "tab"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "side"
      ],
      "title": "TurnStart",
      "type": "object"
    },
    "TurnStop": {
      "properties": {
        "type": {
          "const": "turn.stop",
          "default": "turn.stop",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "TurnStop",
      "type": "object"
    },
    "UtteranceOverrideLang": {
      "properties": {
        "type": {
          "const": "utterance.override_lang",
          "default": "utterance.override_lang",
          "title": "Type",
          "type": "string"
        },
        "utterance_id": {
          "title": "Utterance Id",
          "type": "integer"
        },
        "lang": {
          "enum": [
            "ja",
            "en",
            "vi"
          ],
          "title": "Lang",
          "type": "string"
        }
      },
      "required": [
        "utterance_id",
        "lang"
      ],
      "title": "UtteranceOverrideLang",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "client.health": "#/$defs/ClientHealth",
      "ping": "#/$defs/Ping",
      "session.start": "#/$defs/SessionStart",
      "sides.update": "#/$defs/SidesUpdate",
      "turn.start": "#/$defs/TurnStart",
      "turn.stop": "#/$defs/TurnStop",
      "utterance.override_lang": "#/$defs/UtteranceOverrideLang"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/SessionStart"
    },
    {
      "$ref": "#/$defs/TurnStart"
    },
    {
      "$ref": "#/$defs/TurnStop"
    },
    {
      "$ref": "#/$defs/UtteranceOverrideLang"
    },
    {
      "$ref": "#/$defs/SidesUpdate"
    },
    {
      "$ref": "#/$defs/Ping"
    },
    {
      "$ref": "#/$defs/ClientHealth"
    }
  ]
}