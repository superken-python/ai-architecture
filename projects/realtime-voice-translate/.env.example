RVT_API_KEY=your_secret_api_key_here
HF_TOKEN=your_huggingface_token_here_if_using_gemma
RVT_MAX_SESSIONS=4
RVT_ENVIRONMENT=development
# Model dịch trong models/ (Qwen 2.5 7B Instruct GGUF Q5_K_M)
RVT_MT_MODEL_FILE=qwen2.5-7b-instruct-q5_k_m.gguf
# Glossary cho bộ dịch (packs/glossary/<tên>.yaml), ví dụ default,naruto
RVT_GLOSSARIES=default
# Dò vùng audio to mà VAD bỏ sót khi thu âm tab (docs 09 §4.1)
RVT_VAD_PROBE=true
# beam_size cho câu chốt (1 = tham lam như trước); thử 5 khi đo độ chính xác (docs 10 §10.4)
RVT_ASR_FINAL_BEAM_SIZE=1
# Dịch qua API trên cloud: ./start.sh --api-mt (docs 10 §13). Dán nguyên "Target URI" của deployment Azure, trong ngoặc
# kép vì có dấu "?". Khoá chỉ để trong .env (đã bị git bỏ qua), không commit.
RVT_MT_API_URL="https://<resource>.cognitiveservices.azure.com/openai/deployments/gpt-5.4-mini/chat/completions?api-version=2024-12-01-preview"
RVT_MT_API_KEY=
# Chỉ cần khi URL không có tên deployment (OpenAI, Azure …/openai/v1)
RVT_MT_MODEL=
# auto: gpt-5.4-mini → none, gpt-5-mini → minimal
RVT_MT_REASONING_EFFORT=auto
