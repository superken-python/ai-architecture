RVT_API_KEY=your_secret_api_key_here
HF_TOKEN=your_huggingface_token_here_if_using_gemma
RVT_MAX_SESSIONS=4
RVT_ENVIRONMENT=development
# Model dịch trong models/ (Qwen 2.5 7B Instruct GGUF Q5_K_M)
RVT_MT_MODEL_FILE=qwen2.5-7b-instruct-q5_k_m.gguf
# Glossary cho bộ dịch (packs/glossary/<tên>.yaml), ví dụ default,naruto
RVT_GLOSSARIES=default
# Dò vùng audio to mà VAD bỏ sót khi thu âm tab (docs 09 §4.1)
RVT_VAD_PROBE=true
