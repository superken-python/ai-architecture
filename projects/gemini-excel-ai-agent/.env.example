# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR GEMINI-EXCEL-AI-AGENT (AGNO AGENTOS + AZURE OPENAI)
# ==============================================================================
# LƯU Ý BẢO MẬT: KHÔNG commit file .env chứa API Key thật lên Git repository.
# Sao chép file này thành .env và điền các giá trị cấu hình tương ứng của hệ thống.

# ------------------------------------------------------------------------------
# 1. AZURE OPENAI CONFIGURATION (Model: gpt-5-mini / azure deployment)
# ------------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_MODEL=gpt-5-mini

# ------------------------------------------------------------------------------
# 2. SERVER & GATEWAY CONFIGURATION
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:8000","https://localhost:8000","https://localhost:3000","https://appsforoffice.microsoft.com"]

# ------------------------------------------------------------------------------
# 3. AGNO AGENTOS & MEMORY SETTINGS
# ------------------------------------------------------------------------------
AGENT_ID=excel-copilot-agent
AGENT_NAME=Excel Enterprise Copilot
AGENT_STORAGE_DB=sqlite:///./excel_agent.db
MAX_CHAT_HISTORY=20

# ------------------------------------------------------------------------------
# 4. OBSERVABILITY & LOGGING (LANGFUSE + LOGURU)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false
