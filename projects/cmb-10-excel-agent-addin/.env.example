# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# --- Agent (Agno, model OpenAI qua Responses API) ---
# Để trống → chạy chế độ offline (luật cố định) để thử giao diện khi chưa có key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low        # minimal | low | medium | high (model gpt-5)
OPENAI_STORE=false                 # false = OpenAI không lưu hội thoại; Agno gửi lại ngữ cảnh mỗi lượt
OPENAI_BASE_URL=                   # gateway tương thích OpenAI (để trống → api.openai.com)
AGENT_MODE=auto                    # auto | openai | offline
NUM_HISTORY_RUNS=4                 # số lượt hội thoại trước đưa lại vào ngữ cảnh
TOOL_CALL_LIMIT=12                 # số lần gọi tool tối đa trong một lượt

# --- Server ---
HOST=127.0.0.1
PORT=7777

# --- API dữ liệu ---
# Để trống → dùng API giả lập gắn sẵn trong server (/mock-api, gọi trong tiến trình)
DATA_API_URL=
MOUNT_MOCK_API=true
DEFAULT_DATASET=khach_hang

# --- Lưu trữ (file Excel của web POC theo phiên bản + SQLite session của AgentOS) ---
STORAGE_DIR=./var
