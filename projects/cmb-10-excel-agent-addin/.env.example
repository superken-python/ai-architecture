# Sao chép thành .env rồi điền. KHÔNG commit file .env.

# --- Agent (OpenAI Agents SDK) ---
# Để trống → chạy chế độ offline (luật cố định) để thử giao diện khi chưa có key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low        # minimal | low | medium | high
AGENT_MODE=auto                    # auto | openai | offline
USE_TRIAGE=true                    # agent điều phối + handoff sang agent chuyên trách
MAX_TURNS=8
OPENAI_TRACING=false               # true = gửi trace của Agents SDK lên nền tảng OpenAI
OPENAI_BASE_URL=                   # gateway tương thích OpenAI (để trống → api.openai.com)

# --- Server ---
HOST=127.0.0.1
PORT=7777

# --- API dữ liệu ---
# Để trống → dùng API giả lập gắn sẵn tại http://HOST:PORT/mock-api
DATA_API_URL=
MOUNT_MOCK_API=true
DEFAULT_DATASET=khach_hang

# --- Lưu trữ (file Excel theo phiên bản + SQLite của AgentOS) ---
STORAGE_DIR=./var
